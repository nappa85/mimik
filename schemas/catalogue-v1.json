{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "game_id", "edition_id", "catalogue_id", "title", "sources", "entry_types", "entries"],
  "properties": {
    "contract_version": {"const": 1},
    "game_id": {"$ref": "#/$defs/id"},
    "edition_id": {"$ref": "#/$defs/id"},
    "catalogue_id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/label"},
    "sources": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/source"}},
    "entry_types": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/entry_type"}},
    "entries": {"type": "array", "maxItems": 6144, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64},
    "label": {"type": "string", "minLength": 1, "maxLength": 100},
    "db_id": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "pdf_sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/db_id"},
        "pdf_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    },
    "choice": {
      "type": "object", "additionalProperties": false, "required": ["id", "label"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}}
    },
    "property": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "control"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"},
        "control": {"enum": ["text", "integer", "boolean", "enum"]},
        "options": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/choice"}}
      }
    },
    "entry_type": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "properties"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"},
        "properties": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/property"}}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "page_id", "unit_id"],
      "properties": {"source_id": {"$ref": "#/$defs/db_id"}, "page_id": {"$ref": "#/$defs/db_id"}, "unit_id": {"$ref": "#/$defs/db_id"}}
    },
    "description": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["units"],
          "properties": {"units": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/unit"}}}},
        {"type": "object", "additionalProperties": false, "required": ["owner_text"],
          "properties": {"owner_text": {"type": "string", "minLength": 1, "maxLength": 20000}}}
      ]
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "type", "name", "properties", "description"],
      "properties": {
        "key": {"$ref": "#/$defs/id"},
        "type": {"$ref": "#/$defs/id"},
        "name": {"$ref": "#/$defs/label"},
        "properties": {
          "type": "object", "maxProperties": 16,
          "propertyNames": {"maxLength": 64},
          "additionalProperties": {"oneOf": [
            {"type": "string", "maxLength": 1000},
            {"type": "integer"},
            {"type": "boolean"}
          ]}
        },
        "retired": {"type": "boolean"},
        "description": {"$ref": "#/$defs/description"}
      }
    }
  }
}
