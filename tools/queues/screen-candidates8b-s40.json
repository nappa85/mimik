{
  "schema": 1,
  "name": "screen-candidates8b-s40",
  "description": "Same 40-case dev screen and C0 settings as screen-small-s40, for the 8B dense candidates (q8_0 KV cache per registry, ctx 24576). Exploratory: never a verdict arm.",
  "defaults": {
    "split": "dev",
    "seeds": "17",
    "arm": "S40-c0",
    "cases_file": "tools/case-subsets/dev-screen-40.json",
    "env": {
      "CTX": 24576,
      "MAX_TURNS": 8,
      "MAX_TOKENS": 4096,
      "THINKING": "off",
      "TEMPERATURE": "0.1",
      "TOP_P": "0.95",
      "NUDGE": 1,
      "TURNS_REMAINING": 0,
      "SEARCH_NOTES": 0,
      "SANITIZE_ECHO": 1,
      "PENDING_CURRENT": 1,
      "UNTRUSTED": 0
    }
  },
  "preflight_case": "dev-001",
  "quiet": true,
  "max_consecutive_failures": 2,
  "disk_checks": [
    {
      "path": "/var/lib/docker",
      "min_free_gb": 10
    },
    {
      "path": "/media/data",
      "min_free_gb": 10
    }
  ],
  "arms": [
    {
      "id": "s40-ministral3-8b",
      "model": "ministral3-8b"
    },
    {
      "id": "s40-granite42-8b",
      "model": "granite42-8b"
    },
    {
      "id": "s40-llama31-8b",
      "model": "llama31-8b"
    }
  ]
}
