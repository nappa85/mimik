# AppArmor profile that lets Mimik create the private sandbox of its model server
# (DRAFT, untested: it needs an Ubuntu 24.04 VM; nothing installs it automatically).
#
# Why: Ubuntu 23.10 and later set kernel.apparmor_restrict_unprivileged_userns=1. A program
# without an AppArmor profile that allows `userns` can still create a user namespace, but the
# kernel strips its capabilities inside it, so Mimik's sandbox cannot mount anything and the
# assistant stays unavailable. This profile does not confine Mimik (flags=(unconfined));
# it only grants that one permission to Mimik's own binary, as Ubuntu ships for bubblewrap
# (/etc/apparmor.d/bwrap-userns-restrict).
#
# Install once, as an administrator, after checking that the path below is where Mimik's
# binary is (edit the attachment if it is somewhere else; the profile applies to that file
# only, and the sandbox's helper is the same binary):
#
#   sudo install -m 0644 apparmor/mimik /etc/apparmor.d/mimik
#   sudo apparmor_parser -r /etc/apparmor.d/mimik
#
# Remove with:  sudo apparmor_parser -R /etc/apparmor.d/mimik && sudo rm /etc/apparmor.d/mimik
#
# Check (prints the setting; the assistant page's start-time probe is the real test):
#   cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns
abi <abi/4.0>,
include <tunables/global>

profile mimik /{opt/mimik,usr/local/bin,usr/bin}/mimik flags=(unconfined) {
  userns,

  include if exists <local/mimik>
}
